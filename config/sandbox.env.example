# Example sandbox environment for Packmate lab reproduction.
# Copy to config/sandbox.env (gitignored). Never commit real tokens.

PACKMATE_NAMESPACE=packmate-lab

MODEL_NAMESPACE=my-first-model
MODEL_SERVICE=llama-32-3b-instruct-predictor
MODEL_ID=llama-32-3b-instruct
# Optional: only if the predictor requires a real token.
MODEL_TOKEN=

# Prebuilt lab images (GHCR, Quay, or internal ImageStream digests).
# Prefer digest-pinned references. Never use :latest.
# Example GHCR (after publishing workflow):
#   BACKEND_IMAGE=ghcr.io/lindagh1/packmate-backend:lab-v1.0.0@sha256:...
# Example current sandbox internal registry:
#   BACKEND_IMAGE=image-registry.openshift-image-registry.svc:5000/packmate-lab/packmate-backend@sha256:c057f9f1...
# Published lab-v1.0.0 (public GHCR):
# BACKEND_IMAGE=ghcr.io/lindagh1/packmate-backend@sha256:c10fbeb6fbd63ca478e1b8231ddf874ec7ee1c80663b641d802ffca6e826849f
# FRONTEND_IMAGE=ghcr.io/lindagh1/packmate-frontend@sha256:d6ade3f968a8e1057cb7e846a6dbded4c0f45f8b1780d16d5dd9d76b55d08305
# WEATHER_MCP_IMAGE=ghcr.io/lindagh1/packmate-weather-mcp@sha256:f4a8dcb5407e3bf9dfbb2e494ccb7fc478a377ce074ef2b3f219b55d57443006
# BAGGAGE_POLICY_MCP_IMAGE=ghcr.io/lindagh1/packmate-baggage-policy-mcp@sha256:17432265c056241b6ce89368f9cd1fe0ff5165d3316ef80116285b78b9d58d1a
BACKEND_IMAGE=
FRONTEND_IMAGE=
WEATHER_MCP_IMAGE=
BAGGAGE_POLICY_MCP_IMAGE=

# LLM connection for packmate-llm Secret (values never printed / never committed).
LLM_BASE_URL=http://llama-32-3b-instruct-predictor.my-first-model.svc.cluster.local:8080/v1
LLM_MODEL=llama-32-3b-instruct
LITELLM_API_KEY=dummy

# Feature toggles
REGISTER_MCP=true
CREATE_MODEL_CUSTOM_ENDPOINT=false
CREATE_PIPELINE=true
CREATE_ARGOCD_APPLICATION=true
ALLOW_CREATE_NAMESPACE=false
SKIP_CONFIRM=false

# Git / GitOps placeholders
GIT_REPO_URL=https://github.com/Lindagh1/packmate-agent.git
GIT_REVISION=packmate-v2
ODH_APPLICATIONS_NS=redhat-ods-applications

# Legacy aliases (scripts accept both)
PACKMATE_NS=packmate-lab
PACKMATE_MODEL_ENDPOINT_NAME=packmate-llama-32-3b
PACKMATE_MODEL_DISPLAY_NAME=Packmate Llama 3.2 3B
PACKMATE_MODEL_USE_CASE=Packmate travel planning, weather and baggage tool calling
