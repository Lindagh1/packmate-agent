# Example sandbox environment for Packmate lab reproduction.
# Copy to config/sandbox.env (gitignored). Never commit real tokens.

# DEV = Data Science Project + Workbench + Playground + Pipeline + MCP/app for lab
PACKMATE_DEV_NAMESPACE=packmate-lab
# Legacy alias (scripts still accept PACKMATE_NAMESPACE)
PACKMATE_NAMESPACE=packmate-lab
PACKMATE_NS=packmate-lab

# PROD = runtime only (no Workbench / Pipeline / Playground). Deployed by Argo CD.
PACKMATE_PROD_NAMESPACE=packmate-prod
CREATE_PROD_NAMESPACE=true
CREATE_PROD_SECRETS=true
CREATE_ARGOCD_RBAC=true

MODEL_NAMESPACE=my-first-model
MODEL_SERVICE=llama-32-3b-instruct-predictor
MODEL_ID=llama-32-3b-instruct
# Optional: only if the predictor requires a real token.
MODEL_TOKEN=

# Prebuilt lab images (GHCR). Prefer digest-pinned references. Never use :latest.
# lab-v1.0.0 (public GHCR):
# BACKEND_IMAGE=ghcr.io/lindagh1/packmate-backend@sha256:c10fbeb6fbd63ca478e1b8231ddf874ec7ee1c80663b641d802ffca6e826849f
# FRONTEND_IMAGE=ghcr.io/lindagh1/packmate-frontend@sha256:d6ade3f968a8e1057cb7e846a6dbded4c0f45f8b1780d16d5dd9d76b55d08305
# WEATHER_MCP_IMAGE=ghcr.io/lindagh1/packmate-weather-mcp@sha256:f4a8dcb5407e3bf9dfbb2e494ccb7fc478a377ce074ef2b3f219b55d57443006
# BAGGAGE_POLICY_MCP_IMAGE=ghcr.io/lindagh1/packmate-baggage-policy-mcp@sha256:17432265c056241b6ce89368f9cd1fe0ff5165d3316ef80116285b78b9d58d1a
BACKEND_IMAGE=
FRONTEND_IMAGE=
WEATHER_MCP_IMAGE=
BAGGAGE_POLICY_MCP_IMAGE=

# LLM connection for packmate-llm (DEV) and packmate-prod-llm (PROD) Secrets.
# Values never printed / never committed.
LLM_BASE_URL=http://llama-32-3b-instruct-predictor.my-first-model.svc.cluster.local:8080/v1
LLM_MODEL=llama-32-3b-instruct
LITELLM_API_KEY=dummy

# Feature toggles (official lab defaults)
REGISTER_MCP=true
ENABLE_CUSTOM_ENDPOINTS=true
CREATE_MODEL_CUSTOM_ENDPOINT=true
CREATE_PIPELINE=true
CREATE_ARGOCD_APPLICATION=true
ALLOW_CREATE_NAMESPACE=false
SKIP_CONFIRM=false

# Git / GitOps (fork-first workshop model)
# Canonical upstream is read-only for demonstrations. Always set GIT_REPO_URL to YOUR fork.
CANONICAL_GIT_REPO_URL=https://github.com/Lindagh1/packmate-agent.git
GIT_REPO_URL=https://github.com/YOUR_GITHUB_USERNAME/packmate-agent.git
GIT_REVISION=packmate-v2
PROMOTION_BASE_BRANCH=packmate-v2
# Instructor-only override — never enable for normal participant workshops
ALLOW_CANONICAL_REPO_PROMOTION=false
ODH_APPLICATIONS_NS=redhat-ods-applications
REQUIRE_OPENSHIFT_GITOPS=true
INSTALL_OPENSHIFT_GITOPS_OPERATOR=false
CREATE_DEFAULT_ARGOCD_INSTANCE=true
GITOPS_INSTALL_TIMEOUT_SECONDS=900

# Argo CD SSO / participant RBAC (AppProject role participant — get both, Sync PROD)
PACKMATE_ARGO_GROUP=packmate-lab-users
PACKMATE_PARTICIPANT_USER=
DISABLE_ARGOCD_LOCAL_ADMIN=false

# Portable PROD promotion (durable external registry — never commit internal digests)
PACKMATE_PROMOTION_REGISTRY_MODE=external
PACKMATE_PROMOTION_REGISTRY=ghcr.io
PACKMATE_PROMOTION_REGISTRY_OWNER=Lindagh1
PACKMATE_PROMOTION_IMAGE_NAME=packmate-backend
PACKMATE_PROMOTION_PUSH_SECRET=packmate-ghcr-push
PACKMATE_PROMOTION_PULL_SECRET=packmate-ghcr-pull
PACKMATE_REQUIRE_PORTABLE_PROD_IMAGE=true
PACKMATE_ALLOW_INTERNAL_PROD_IMAGE=false
PACKMATE_INITIAL_PROD_IMAGE_REFERENCE=ghcr.io/lindagh1/packmate-backend@sha256:c10fbeb6fbd63ca478e1b8231ddf874ec7ee1c80663b641d802ffca6e826849f
VERIFY_PROD_IMAGE_BEFORE_ARGO_SYNC=true
# Registry credentials are NEVER placed in this file — use make configure-promotion-registry

# Secret rotation is instructor-only (ordinary bootstrap never rotates)
ROTATE_PACKMATE_PROD_LLM_SECRET=false

# Endpoint display (quote values with spaces)
PACKMATE_MODEL_ENDPOINT_NAME=packmate-llama-32-3b
PACKMATE_MODEL_DISPLAY_NAME="Packmate Llama 3.2 3B"
PACKMATE_MODEL_USE_CASE="Packmate travel planning, weather and baggage tool calling"
